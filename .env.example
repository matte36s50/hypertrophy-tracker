# Strava integration (optional). Copy to .env.local and fill in.
# Create an app at https://www.strava.com/settings/api to get these.
# - "Authorization Callback Domain" must be the host you deploy on
#   (e.g. your-app.vercel.app, or "localhost" for local dev).
# The client secret is server-only and must never be exposed to the browser.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
